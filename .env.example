# GEMINI_API_KEY (optional): fallback Gemini key used by the local server when the
# user has not entered their own key in the app. Anyone who can reach the server can
# spend this key's quota, so keep HOST on loopback unless the server is behind auth.
GEMINI_API_KEY=""

# PORT: HTTP port for `npm run dev` (default 32600).
PORT=32600

# HOST: bind address (default 127.0.0.1). Use 0.0.0.0 only behind a reverse proxy with auth.
HOST=127.0.0.1
